{
  "enabled": true,
  "allowBrowserProcess": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowedDomains": ["github.com", "*.github.com"],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [],
    "allowRead": [
      "~/Projects/github/AGENTS.md", 
      "~/Projects/github/gcaracuel/AGENTS.md", 
      ".",
      "~/.config", 
      "~/.local"
    ],
    "allowWrite": [".", "../.git", "/tmp"],
