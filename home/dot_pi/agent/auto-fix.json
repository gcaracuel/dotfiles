{
  "enabled": false,
  "timeoutMs": 90000,
  "concurrency": 2,
  "ignore": ["node_modules/", "dist/", ".git/", "vendor/"],
  "fixers": [
    {
      "label": "biome",
      "extensions": [".ts", ".tsx", ".js", ".jsx"],
      "command": "npx --no-install biome check --write --no-errors-on-unmatched {files}"
    },
    {
      "label": "ruff",
      "extensions": [".py"],
      "command": "ruff check --fix {files} && ruff format {files}"
    }
  ]
}