#!/usr/bin/env bash
# run_onchange_06-cargo-packages.sh.tmpl
# Installs/uninstalls Rust packages via mise (rust/cargo runtime).
# Re-runs whenever cargo-packages.txt changes.
#
# chezmoi:template:left-delim="{{" right-delim="}}"
#
# cargo-packages.txt hash: {{ include (joinPath (output "readlink" "-f" .chezmoi.sourceDir | trim) "../packages/cargo-packages.txt") | sha256sum }}

set -euo pipefail

REPO_DIR="{{ output "readlink" "-f" .chezmoi.sourceDir | trim }}/.." 
PACKAGES_FILE="$REPO_DIR/packages/cargo-packages.txt"
STATE_DIR="$HOME/.local/share/dotfiles-state"
STATE_FILE="$STATE_DIR/cargo-installed.txt"

mkdir -p "$STATE_DIR"

# Detect if this is a forced reinstall (marker file created by `just reinstall cargo`)
FORCE_REINSTALL=false
MARKER="$STATE_DIR/.force-reinstall-cargo"
if [[ -f "$MARKER" ]]; then
  FORCE_REINSTALL=true
  rm -f "$MARKER"
  echo "==> [cargo] Force reinstall requested"
fi

# Activate mise for this session
if command -v mise &>/dev/null; then
  eval "$(mise activate bash)" 2>/dev/null || true
fi

# Add keg-only zig@0.15 to PATH (needed by herdr's vendored libghostty-vt)
if [[ -x /opt/homebrew/opt/zig@0.15/bin/zig ]]; then
  export PATH="/opt/homebrew/opt/zig@0.15/bin:$PATH"
elif [[ -x /home/linuxbrew/.linuxbrew/opt/zig@0.15/bin/zig ]]; then
  export PATH="/home/linuxbrew/.linuxbrew/opt/zig@0.15/bin:$PATH"
fi

if ! command -v cargo &>/dev/null; then
  echo "ERROR: cargo not found. Ensure rust is installed via mise." >&2
  exit 1
fi

# Parse package list (strip comments, blank lines, inline comments)
# Returns just the package name (before any | separator)
parse_packages() {
  grep -v '^\s*#' "$1" | grep -v '^\s*$' | awk '{print $1}' | cut -d'|' -f1 || true
}

parse_entries() {
  grep -v '^\s*#' "$1" | grep -v '^\s*$' | awk '{print $1}' || true
}

DESIRED_NAMES=$(parse_packages "$PACKAGES_FILE")

# --- Uninstall removed packages ---
if [[ -f "$STATE_FILE" ]]; then
  REMOVED=$(comm -23 <(sort "$STATE_FILE") <(echo "$DESIRED_NAMES" | sort) || true)
  if [[ -n "$REMOVED" ]]; then
    echo "==> [cargo] Uninstalling removed packages:"
    while IFS= read -r pkg; do
      echo "    - $pkg"
      cargo uninstall "$pkg" || echo "    WARNING: could not uninstall $pkg" >&2
    done <<< "$REMOVED"
  fi
fi

# --- Install desired packages ---
echo "==> [cargo] Checking packages..."
installed_count=0
skipped_count=0

while IFS= read -r entry; do
  [[ -z "$entry" ]] && continue
  name="${entry%%|*}"
  git_url="${entry#*|}"

  # Check if package is already installed (skip check if force reinstall)
  if [[ "$FORCE_REINSTALL" == "false" ]] && cargo install --list | grep -q "^${name} v"; then
    echo "    ✓ $name (already installed)"
    skipped_count=$((skipped_count + 1))
    continue
  fi

  FORCE_FLAG=""
  if [[ "$FORCE_REINSTALL" == "true" ]]; then
    FORCE_FLAG="--force"
  fi

  if [[ "$name" == "$git_url" ]]; then
    # No git URL — install from crates.io
    echo "    + $name (crates.io)"
    if cargo install $FORCE_FLAG "$name"; then
      installed_count=$((installed_count + 1))
    else
      echo "    WARNING: failed to install $name" >&2
    fi
  else
    # Git URL provided
    echo "    + $name (git: $git_url)"
    if cargo install $FORCE_FLAG --git "$git_url"; then
      installed_count=$((installed_count + 1))
    else
      echo "    WARNING: failed to install $name from git" >&2
    fi
  fi
done < <(parse_entries "$PACKAGES_FILE")

if [[ $installed_count -eq 0 ]] && [[ $skipped_count -gt 0 ]]; then
  echo "==> [cargo] All packages already installed, skipped compilation."
elif [[ $installed_count -gt 0 ]]; then
  echo "==> [cargo] Installed $installed_count package(s)."
fi

echo "$DESIRED_NAMES" | sort > "$STATE_FILE"
echo "==> [cargo] Done."
