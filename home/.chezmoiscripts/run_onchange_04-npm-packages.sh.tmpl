#!/usr/bin/env bash
# run_onchange_04-npm-packages.sh.tmpl
# Installs/uninstalls global npm packages via mise (node runtime).
# Re-runs whenever npm-packages.txt changes.
#
# chezmoi:template:left-delim="{{" right-delim="}}"
#
# npm-packages.txt hash: {{ include (joinPath (output "readlink" "-f" .chezmoi.sourceDir | trim) "../packages/npm-packages.txt") | sha256sum }}

set -euo pipefail

REPO_DIR="{{ output "readlink" "-f" .chezmoi.sourceDir | trim }}/.." 
PACKAGES_FILE="$REPO_DIR/packages/npm-packages.txt"
STATE_DIR="$HOME/.local/share/dotfiles-state"
STATE_FILE="$STATE_DIR/npm-installed.txt"

mkdir -p "$STATE_DIR"

# Activate mise for this session
if command -v mise &>/dev/null; then
  eval "$(mise activate bash)" 2>/dev/null || true
fi

if ! command -v npm &>/dev/null; then
  echo "ERROR: npm not found. Ensure node is installed via mise." >&2
  exit 1
fi

# Parse package list (strip comments, blank lines, inline comments)
parse_packages() {
  grep -v '^\s*#' "$1" | grep -v '^\s*$' | awk '{print $1}' || true
}

DESIRED=$(parse_packages "$PACKAGES_FILE")

# --- Uninstall removed packages ---
if [[ -f "$STATE_FILE" ]]; then
  REMOVED=$(comm -23 <(sort "$STATE_FILE") <(echo "$DESIRED" | sort) || true)
  if [[ -n "$REMOVED" ]]; then
    echo "==> [npm] Uninstalling removed packages:"
    while IFS= read -r pkg; do
      echo "    - $pkg"
      npm uninstall -g "$pkg" || echo "    WARNING: could not uninstall $pkg"
    done <<< "$REMOVED"
  fi
fi

# --- Install desired packages ---
echo "==> [npm] Checking packages..."
INSTALLED=$(npm list -g --depth=0 2>/dev/null | tail -n +2 | awk '{print $1}' | cut -d'@' -f1 || true)
installed_count=0
skipped_count=0

while IFS= read -r pkg; do
  [[ -z "$pkg" ]] && continue
  
  if echo "$INSTALLED" | grep -q "^${pkg}$"; then
    echo "    ✓ $pkg (already installed)"
    skipped_count=$((skipped_count + 1))
  else
    echo "    + $pkg"
    if npm install -g "$pkg"; then
      installed_count=$((installed_count + 1))
    else
      echo "    WARNING: failed to install $pkg" >&2
    fi
  fi
done <<< "$DESIRED"

if [[ $installed_count -eq 0 ]] && [[ $skipped_count -gt 0 ]]; then
  echo "==> [npm] All packages already installed."
elif [[ $installed_count -gt 0 ]]; then
  echo "==> [npm] Installed $installed_count package(s)."
fi

echo "$DESIRED" | sort > "$STATE_FILE"
echo "==> [npm] Done."
