#!/usr/bin/env bash
# run_onchange_05-pip-packages.sh.tmpl
# Installs/uninstalls Python packages via mise (uv/python runtime).
# Prefers uv tool install for isolated environments; falls back to pip.
# Re-runs whenever pip-packages.txt changes.
#
# chezmoi:template:left-delim="{{" right-delim="}}"
#
# pip-packages.txt hash: {{ include (joinPath (output "readlink" "-f" .chezmoi.sourceDir | trim) "../packages/pip-packages.txt") | sha256sum }}

set -euo pipefail

REPO_DIR="{{ output "readlink" "-f" .chezmoi.sourceDir | trim }}/.." 
PACKAGES_FILE="$REPO_DIR/packages/pip-packages.txt"
STATE_DIR="$HOME/.local/share/dotfiles-state"
STATE_FILE="$STATE_DIR/pip-installed.txt"

mkdir -p "$STATE_DIR"

# Detect if this is a forced reinstall (marker file created by `just reinstall pip`)
FORCE_REINSTALL=false
MARKER="$STATE_DIR/.force-reinstall-pip"
if [[ -f "$MARKER" ]]; then
  FORCE_REINSTALL=true
  rm -f "$MARKER"
  echo "==> [pip] Force reinstall requested"
fi

# Activate mise for this session
if command -v mise &>/dev/null; then
  eval "$(mise activate bash)" 2>/dev/null || true
fi

# Parse package list (strip comments, blank lines, inline comments)
parse_packages() {
  grep -v '^\s*#' "$1" | grep -v '^\s*$' | awk '{print $1}' || true
}

DESIRED=$(parse_packages "$PACKAGES_FILE")

# Prefer uv tool install (isolated), fall back to pip
install_pkg() {
  local pkg="$1"
  local force="$2"
  if command -v uv &>/dev/null; then
    if [[ "$force" == "true" ]]; then
      uv tool install --reinstall "$pkg" || echo "    WARNING: failed to upgrade $pkg via uv" >&2
    else
      uv tool install "$pkg" || echo "    WARNING: failed to install $pkg via uv" >&2
    fi
  elif command -v pip3 &>/dev/null; then
    if [[ "$force" == "true" ]]; then
      pip3 install --user --upgrade "$pkg" || echo "    WARNING: failed to upgrade $pkg via pip3" >&2
    else
      pip3 install --user "$pkg" || echo "    WARNING: failed to install $pkg via pip3" >&2
    fi
  else
    echo "    WARNING: neither uv nor pip3 found, skipping $pkg" >&2
  fi
}

uninstall_pkg() {
  local pkg="$1"
  if command -v uv &>/dev/null; then
    uv tool uninstall "$pkg" || echo "    WARNING: could not uninstall $pkg" >&2
  elif command -v pip3 &>/dev/null; then
    pip3 uninstall -y "$pkg" || echo "    WARNING: could not uninstall $pkg" >&2
  fi
}

# --- Uninstall removed packages ---
if [[ -f "$STATE_FILE" ]]; then
  REMOVED=$(comm -23 <(sort "$STATE_FILE") <(echo "$DESIRED" | sort) || true)
  if [[ -n "$REMOVED" ]]; then
    echo "==> [pip] Uninstalling removed packages:"
    while IFS= read -r pkg; do
      echo "    - $pkg"
      uninstall_pkg "$pkg"
    done <<< "$REMOVED"
  fi
fi

# --- Install desired packages ---
echo "==> [pip] Checking packages..."
installed_count=0
skipped_count=0

# Get list of installed packages
if command -v uv &>/dev/null; then
  INSTALLED=$(uv tool list 2>/dev/null | grep -v '^$' | awk '{print $1}' || true)
else
  INSTALLED=$(pip3 list --user 2>/dev/null | tail -n +3 | awk '{print $1}' || true)
fi

while IFS= read -r pkg; do
  [[ -z "$pkg" ]] && continue
  
  if [[ "$FORCE_REINSTALL" == "false" ]] && echo "$INSTALLED" | grep -q "^${pkg}$"; then
    echo "    ✓ $pkg (already installed)"
    skipped_count=$((skipped_count + 1))
  else
    echo "    + $pkg"
    if install_pkg "$pkg" "$FORCE_REINSTALL"; then
      installed_count=$((installed_count + 1))
    fi
  fi
done <<< "$DESIRED"

if [[ $installed_count -eq 0 ]] && [[ $skipped_count -gt 0 ]]; then
  echo "==> [pip] All packages already installed."
elif [[ $installed_count -gt 0 ]]; then
  echo "==> [pip] Installed $installed_count package(s)."
fi

echo "$DESIRED" | sort > "$STATE_FILE"
echo "==> [pip] Done."
